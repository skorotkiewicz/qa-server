# QA Server Configuration

# Server bind address (can be overridden by QA_SERVER_IP and QA_SERVER_PORT env vars)
bind: "0.0.0.0:7879"

# Database URL (SQLite) - can be overridden by DATABASE_URL env var
database_url: "sqlite://qa.db"

# Database connection pool size (default: 10)
# Increase for high concurrency (e.g., 20-50)
db_pool_size: 10

# Optional: Redis URL for caching (can be overridden by REDIS_URL env var)
# Example: "redis://127.0.0.1:6379" or "redis://username:password@localhost:6379"
# redis_url: "redis://127.0.0.1:6379"

# Environment Variables (override config file settings):
#   QA_SERVER_IP      - Server IP address (default: 0.0.0.0)
#   QA_SERVER_PORT    - Server port (default: 7879)
#   DATABASE_URL      - Database connection URL
#   REDIS_URL         - Redis connection URL
#
# Example:
#   export QA_SERVER_IP=127.0.0.1
#   export QA_SERVER_PORT=8080
#   export DATABASE_URL=sqlite:///var/lib/qa/qa.db
#   export REDIS_URL=redis://127.0.0.1:6379/0
