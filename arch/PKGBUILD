# Maintainer: Sebastian Korotkiewicz <skorotkiewicz@gmail.com>
pkgname=qa-server
pkgver=0.1.0
pkgrel=1
pkgdesc="Simple Q&A system with HTTP API server"
arch=('x86_64' 'aarch64')
url="https://github.com/skorotkiewicz/qa-server"
license=('MIT')
depends=('gcc-libs')
options=(!strip)
install=qa-server.install

source_x86_64=("$pkgname-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/qa-server-v$pkgver-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("$pkgname-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/qa-server-v$pkgver-aarch64-unknown-linux-gnu.tar.gz")

sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  install -Dm755 "qa-server" "$pkgdir/usr/bin/qa-server"
  install -Dm755 "qa" "$pkgdir/usr/bin/qa"

  install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "server.yml.example" "$pkgdir/usr/share/doc/$pkgname/server.yml.example"
  install -Dm644 "client.yml.example" "$pkgdir/usr/share/doc/$pkgname/client.yml.example"

  install -Dm644 "systemd/qa-server.service" "$pkgdir/usr/lib/systemd/system/qa-server.service"
  install -Dm644 "systemd/qa-server-user.service" "$pkgdir/usr/lib/systemd/user/qa-server.service"
}
